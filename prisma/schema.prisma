// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id @default(uuid())
  username            String         @unique
  email               String         @unique
  passwordHash        String
  name                String
  genero              String?
  rangoEdad           String?
  provinciaResidencia String?
  lugarFavorito       String?
  tipoLugarPreferido  String?
  estiloViaje         String?
  companiaHabitual    String?
  playMode            String?
  isAdmin             Boolean        @default(false)
  onboardingCompleted Boolean        @default(false)
  resetPasswordToken  String?
  resetPasswordExpires DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  // XP y Niveles
  xp                  Int            @default(0)
  level               Int            @default(1)
  
  // Gamificación (Rachas)
  currentStreak       Int            @default(0)
  longestStreak       Int            @default(0)
  lastLoginDate       DateTime?

  // Auditoria legal
  termsAccepted       Boolean        @default(false)
  termsAcceptedAt     DateTime?
  termsVersion        String?
  
  // Relación con progreso
  progress            UserProgress[]
  ratings             Rating[]
  actionLogs          UserActionLog[]
}

model Lugar {
  id               String         @id @default(uuid())
  nombre           String         @unique
  nombre_en        String?
  categoria        CategoriaLugar
  descripcion      String
  descripcion_en   String?
  ubicacion        String
  imagenUrl        String?
  grupo_variante   String?
  edition          String         @default("FOUNDER")
  isVisible        Boolean        @default(true)
  authorName       String?
  authorSocialLink String?
  createdAt        DateTime       @default(now())
  
  // Relación con progreso de usuarios
  userProgress UserProgress[]
  ratings      Rating[]
}

model UserProgress {
  id              String   @id @default(uuid())
  userId          String
  lugarId         String
  completado      Boolean  @default(false)
  fechaCompletado DateTime?
  notas           String?

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lugar           Lugar    @relation(fields: [lugarId], references: [id], onDelete: Cascade)

  @@unique([userId, lugarId]) // Un usuario solo puede tener un registro de progreso por lugar
}

enum CategoriaLugar {
  PROVINCIA
  VOLCAN
  PARQUE_NACIONAL
  PLAYA
  RIOS_Y_CATARATAS
  LAGUNAS
  CIUDAD_Y_CULTURA
  BOSQUES_RESERVAS
}
model CommunityPost {
  id        String   @id @default(cuid())
  imageUrl  String?
  caption   String?
  createdAt DateTime @default(now())
  userId    String
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lugar     Lugar    @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model UserActionLog {
  id         String   @id @default(uuid())
  userId     String
  actionType String   // e.g. 'UNLOCK_POSTCARD', 'RATE_DESTINATION'
  targetId   String   // e.g. '123-abc'
  xpAwarded  Int
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
